# Copy to .env (never commit .env).

# --- LLM: any OpenAI-compatible endpoint -------------------------------------------------
# GapGPT: check the exact base URL and model names in your GapGPT dashboard.
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_API_KEY=put-your-api-key
LLM_MODEL=gpt-4o-mini

# --- Database (the PostgreSQL from the Hotel-Booking-Demand project) ----------------------
# Use the SAME host port as that project's docker-compose (5432 by default, or 5433 if you
# remapped it).  The agent connects with a READ-ONLY role created by `make db-role`.
DATABASE_URL=postgresql+psycopg://agent_ro:agent_ro@localhost:5433/hotel
ADMIN_DATABASE_URL=postgresql+psycopg://hotel:hotel@localhost:5433/hotel

# --- Prediction API (Hotel-Booking-Demand: `make serve`) -----------------------------------
PREDICT_API_URL=http://localhost:8000

# --- Limits (optional) ------------------------------------------------------------------------
# SQL_TIMEOUT_MS=5000
# MAX_ROWS=50
# MAX_STEPS=8
